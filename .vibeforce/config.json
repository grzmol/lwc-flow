{
  "apiVersion": "67.0",
  "packageDirectories": [
    "force-app"
  ],
  "orgs": {
    "dev": "lwcflow-dev",
    "integration": "lwcflow-int",
    "uat": "lwcflow-uat",
    "prod": "lwcflow-prod"
  },
  "defaultOrgKey": "dev",
  "productionAliases": [
    "lwcflow-prod",
    "prod",
    "production"
  ],
  "gates": {
    "apexOrgCoverageMin": 85,
    "apexClassCoverageMin": 75,
    "jestCoverageMin": 80,
    "analyzerFailSeverity": 3,
    "requireTestForApexClass": true,
    "requireJestForLwc": true,
    "previewBundlePattern": "(?:Harness|Fixtures)$"
  },
  "hooks": {
    "mode": "standard",
    "blockProductionDeploy": true,
    "blockDestructive": true,
    "autoFormat": true,
    "enforceOwnership": true
  }
}
