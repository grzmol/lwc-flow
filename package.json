{
  "name": "lwc-flow",
  "private": true,
  "version": "0.1.0",
  "description": "LWC-xyflow: node-based flow editor for Salesforce Lightning Web Components. A port of xyflow (@xyflow/react 12.11.6, @xyflow/system 0.0.82) with no runtime dependencies.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "sfdx-lwc-jest",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:debug": "sfdx-lwc-jest --debug",
    "test:unit:coverage": "sfdx-lwc-jest -- --coverage",
    "lint": "eslint \"force-app/**/lwc/**/*.js\"",
    "format": "prettier --write \"**/*.{js,html,css,json,md,yml,yaml,xml}\"",
    "format:verify": "prettier --check \"**/*.{js,html,css,json,md,yml,yaml,xml}\"",
    "demo:build": "rollup --config rollup.config.mjs",
    "demo": "npm run demo:build && node docs/serve.mjs",
    "vf:local": "node \"${CLAUDE_PLUGIN_ROOT:-../vibe-force}/scripts/checks/vf-check.mjs\" local",
    "vf:verify": "node \"${CLAUDE_PLUGIN_ROOT:-../vibe-force}/scripts/checks/vf-check.mjs\" verify"
  },
  "devDependencies": {
    "@lwc/eslint-plugin-lwc": "^3.5.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@salesforce/eslint-config-lwc": "^4.1.2",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.9.0",
    "eslint": "^9.39.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "lwc": "9.4.3",
    "prettier": "^3.9.6",
    "rollup": "^4.63.3"
  }
}
